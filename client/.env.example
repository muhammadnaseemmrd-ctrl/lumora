# Base URL of the API server. Leave as /api during local dev (Vite proxies
# it to http://localhost:5000 — see vite.config.js). Set to your deployed
# API's full URL (e.g. https://api.lumorabeauty.pk/api) in production.
VITE_API_URL=/api

